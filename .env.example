# =============================================================================
# SIMPUL Admin Console - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# The admin console ONLY acts as a client/consumer of the external SIMPUL REST API.
# It does NOT connect to a database or create its own API routes for business logic.
# =============================================================================

# API Backend (WAJIB) — base URL of the running SIMPUL backend server.
# Production WAJIB HTTPS, contoh: https://backend-simpul.vercel.app
NEXT_PUBLIC_API_BASE_URL="http://your-api-url"

# --- Vercel Deployment ---
# Di Vercel, set env ini di Project Settings → Environment Variables:
#   NEXT_PUBLIC_API_BASE_URL = https://backend-simpul.vercel.app
# JANGAN commit .env.local — file ini di-gitignore.
#
# Catatan keamanan:
# - Admin console TIDAK memakai NEXTAUTH_* atau MIDTRANS_* — sudah dihapus.
# - Backend harus diset ALLOWED_ORIGINS berisi domain admin ini (lihat
#   backend/.env) — kalau kosong, backend mengizinkan SEMUA origin (tidak aman).
