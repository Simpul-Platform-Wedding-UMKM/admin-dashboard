# =============================================================================
# SIMPUL Admin Console - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# The admin console ONLY acts as a client/consumer of the external SIMPUL REST API.
# It does NOT connect to a database or create its own API routes for business logic.
# =============================================================================

# API Backend (WAJIB) — base URL of the running SIMPUL backend server.
# Example: http://localhost:4000 or https://api.simpul.id
NEXT_PUBLIC_API_BASE_URL="http://your-api-url"

# Auth — used by NextAuth.js if/when integrated.
NEXTAUTH_SECRET="your-secret-random"
NEXTAUTH_URL="http://your-next-auth-url"

# Payment Gateway — PJP Kategori 1
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# --- Server ---
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005,http://localhost:8081,http://localhost:19006